{# Static shell only: never receives user content (spec §9.2). Texts come from translations/. #}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="no-referrer">
    <meta name="color-scheme" content="light dark">
    <meta name="ql-config" content="{{ settings }}">
    <title>{{ title }} · {{ name }}</title>
    {% for css in assets.css %}
    <link rel="stylesheet" href="{{ css }}">
    {% endfor %}
    {% if tokens %}
    <link rel="stylesheet" href="{{ tokens }}">
    {% endif %}
    {% if manifest %}
    <link rel="manifest" href="/manifest.json">
    {% endif %}
    {% if assets.js %}
    <script type="module" src="{{ assets.js }}"></script>
    {% endif %}
</head>
<body>
    <a class="skip-link" id="ql-skip" href="#main">{{ skip }}</a>
    <header class="site-header">
        <a class="brand" href="/">{{ name }}</a>
        <div class="controls" id="ql-controls"></div>
    </header>
    <main id="main" tabindex="-1">
        <h1 class="page-title">{{ title }}</h1>
        <noscript><p class="error">{{ noscript }}</p></noscript>
    </main>
    <footer class="site-footer">
        <a id="ql-footer-how" href="/how-it-works">{{ how }}</a>
        <a id="ql-footer-source" href="{{ source_url }}" rel="noopener noreferrer">{{ source }}</a>
    </footer>
</body>
</html>
